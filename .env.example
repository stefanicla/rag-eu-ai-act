# Copy to .env and adjust:  cp .env.example .env
# One model switch covers the whole stack. No secrets in this file.
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# Small and fast on CPU (~1.6 GB). Alternatives: qwen3:4b, qwen3:8b or llama3.1:8b.
# GPU: 6GB VRAM (e.g. GTX 1660 Ti) -> keep openbmb/minicpm5-2b. 12GB+ VRAM -> qwen3:8b/14b or llama3.1:8b.
LLM_MODEL=openbmb/minicpm5-2b
# Caps Ollama num_ctx. MiniCPM5 defaults to 4k (safe). Qwen3 defaults to 32k,
# whose KV cache OOM-kills CPU boxes - keep the cap if you switch back to Qwen.
# GPU overlay reads this too: 4096 safe for 6GB VRAM, 8192+ only with bigger VRAM.
LLM_NUM_CTX=4096
# LLM request timeout in seconds. CPU inference can take 60-180s for longer answers.
LLM_REQUEST_TIMEOUT=300
EMBED_MODEL=nomic-embed-text

COLLECTION=ai_act_en
DATA_DIR=data/raw
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=4
SCORE_THRESHOLD=0.40
